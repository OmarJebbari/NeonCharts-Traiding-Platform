# Backend server
PORT=5000

# Postgres / Neon connection (required)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# If you keep this placeholder value, backend auto-falls back to in-memory dev mode.

# Optional DB SSL override (true/false)
PGSSL=true

# Auth
JWT_SECRET=change_me_with_long_random_value
JWT_EXPIRES_IN=7d

# Cookie hardening
# Local HTTP dev should keep this false. Set true in production HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Gemini AI (server-side only)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
